  "dialogos": {
    "monokuma_intro": [
      {
        "texto": "...",
        "expresion": "neutral",
        "efecto": null
      },
      {
        "texto": "Vaya, vaya. Parece que tenemos un nuevo participante.",
        "expresion": "riendo",
        "efecto": null
      },
      {
        "texto": "Permíteme presentarme. Soy Monokuma, tu adorable anfitrión en esta hermosa isla.",
        "expresion": "feliz",
        "efecto": null
      },
      {
        "texto": "Bienvenido a la Isla Jabberwock. Preciosa, verdad? Lástima que no puedas irte.",
        "expresion": "serio",
        "efecto": null
      },
      {
        "texto": "Aquí encontrarás a algunos estudiantes muy interesantes. Cada uno tiene algo para ti.",
        "expresion": "despreocupado",
        "efecto": null
      },
      {
        "texto": "Pero antes de empezar, necesito registrarte oficialmente en el e-Handbook.",
        "expresion": "curioso",
        "efecto": null
      },
      {
        "texto": "Dime... cual es tu talento, Super Estudiante?",
        "expresion": "riendo",
        "efecto": "input_talento"
      },
      {
        "texto": "",
        "expresion": "feliz",
        "efecto": "reaccion_talento"
      },
      {
        "texto": "Perfecto. Queda registrado en el e-Handbook. Que empiece el show!",
        "expresion": "serio",
        "efecto": "registrar"
      }
    ],
    "monokuma_talento_duplicado": "Espera... ¿otro Súper {0}? Esto se pone interesante. ¡Upupupu!",
    "monokuma_talento_nuevo": "¡Súper {0}! Qué título tan... peculiar. ¡Upupupu!",
    "hiyoko": [
      {
        "texto": "Que haces aqui, torpe?",
        "expresion": "burlona",
        "efecto": null
      },
      {
        "texto": "Si quieres pasar, demuestra que tienes algo de ritmo.",
        "expresion": "pretenciosa",
        "efecto": null
      },
      {
        "texto": "El bon odori tiene un orden sagrado. Cada paso en su momento.",
        "expresion": "feliz",
        "efecto": null
      },
      {
        "texto": "Listo para intentarlo?",
        "expresion": "curiosa",
        "efecto": null
      }
    ],
    "gundham": [
      {
        "texto": "Mortal! Has osado entrar al dominio de los Cuatro Jinetes Oscuros.",
        "expresion": "dramatico",
        "efecto": null
      },
      {
        "texto": "Mis cuatro guardianes obedecen un orden cosmico inamovible.",
        "expresion": "serio",
        "efecto": null
      },
      {
        "texto": "Eh? Que quieres entender de lo que hablo?",
        "expresion": "confundido",
        "efecto": null
      },
      {
        "texto": "Si los invocas en el orden correcto... considerare dejarte pasar.",
        "expresion": "relajado",
        "efecto": null
      }
    ],
    "chiaki": [
      {
        "texto": "...Ah, hola.",
        "expresion": "tranquila",
        "efecto": null
      },
      {
        "texto": "Todo juego tiene un patron. Si lo memorizas, siempre puedes ganar.",
        "expresion": "curiosa",
        "efecto": null
      },
      {
        "texto": "Te voy a mostrar algo. Solo tienes que recordarlo exactamente.",
        "expresion": "pensando",
        "efecto": null
      },
      {
        "texto": "¿Listo para intentarlo?",
        "expresion": "sorprendida",
        "efecto": null
      }
    ],
    "nagito": [
      {
        "texto": "Oh... no esperaba visita. Aunque la suerte siempre encuentra su camino.",
        "expresion": "feliz",
        "efecto": null
      },
      {
        "texto": "La logica es la unica esperanza verdadera, no crees?",
        "expresion": "pensativo",
        "efecto": null
      },
      {
        "texto": "Permiteme hacerte unas preguntas. Para alguien con esperanza, no seran problema.",
        "expresion": "intenso",
        "efecto": null
      }
    ],
    "monokuma": [
      {
        "texto": "Upupupu... así que llegaste hasta aquí.",
        "expresion": "riendo",
        "efecto": null
      },
      {
        "texto": "Pensé que te rendirías. Pero aquí estás, con tus cuatro fragmentos de esperanza.",
        "expresion": "serio",
        "efecto": null
      },
      {
        "texto": "Muy bien. La puerta de salida tiene un código de cuatro dígitos.",
        "expresion": "curioso",
        "efecto": null
      },
      {
        "texto": "Cada uno de mis queridos estudiantes tiene uno. Visítalos en el sentido de las manecillas del reloj y obtendrás lo que buscas.",
        "expresion": "despreocupado",
        "efecto": null
      },
      {
        "texto": "¿Podrás descifrarlos todos? ¡Upupupu!",
        "expresion": "riendo",
        "efecto": null
      }
    ],
    "hiyoko_pista": [
      {
        "texto": "¿Otra vez tú? Qué pesado.",
        "expresion": "burlona",
        "efecto": null
      },
      {
        "texto": "Está bien, está bien. Mi número... son los pasos del primer movimiento del bon odori.",
        "expresion": "pretenciosa",
        "efecto": null
      },
      {
        "texto": "Uno, dos, tres. ¿Lo entiendes, torpe? Tres pasos. Ese es mi número.",
        "expresion": "curiosa",
        "efecto": null
      }
    ],
    "gundham_pista": [
      {
        "texto": "Mortal... has regresado.",
        "expresion": "serio",
        "efecto": null
      },
      {
        "texto": "Los Siete Sellos del Abismo fueron rotos por mis Cuatro Jinetes más los Tres Espíritus Ancestrales.",
        "expresion": "dramatico",
        "efecto": null
      },
      {
        "texto": "Recuerda ese número. Siete. Es todo lo que necesitas saber.",
        "expresion": "relajado",
        "efecto": null
      }
    ],
    "chiaki_pista": [
      {
        "texto": "Ah, volviste.",
        "expresion": "tranquila",
        "efecto": null
      },
      {
        "texto": "En todo juego hay un jugador número uno. El primero. El que empieza siempre.",
        "expresion": "curiosa",
        "efecto": null
      },
      {
        "texto": "Mi número es ese. El primero. ¿Entiendes?",
        "expresion": "pensando",
        "efecto": null
      }
    ],
    "nagito_pista": [
      {
        "texto": "Oh... qué coincidencia que hayas regresado.",
        "expresion": "feliz",
        "efecto": null
      },
      {
        "texto": "Cuatro fragmentos de esperanza. Cuatro almas que confiaron en ti.",
        "expresion": "pensativo",
        "efecto": null
      },
      {
        "texto": "La respuesta siempre estuvo en lo que ya tenías. Mi número es cuatro.",
        "expresion": "intenso",
        "efecto": null
      }
    ]
